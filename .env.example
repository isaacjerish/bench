# Copy to .env and fill in. The dashboard reads .env at startup and never
# overrides a variable that is already set in the shell. .env is gitignored;
# keep the real file out of commits and out of screen shares.

# Phone capture. Bind to the LAN so the phone can reach the capture page, and
# publish an address the phone can actually open. Never a localhost address.
#
# Fill in this computer's own Wi-Fi address, or a tunnel URL. Do not copy the
# line below as-is; find your address with:
#   (Get-NetIPAddress -AddressFamily IPv4 -InterfaceAlias Wi-Fi).IPAddress
# Benchy warns when this points at an IP that is not one of your own.
BENCHY_BIND_HOST=0.0.0.0
BENCHY_PUBLIC_BASE_URL=

# Visual inspection. The key stays in the dashboard process and is never sent
# to the browser.
BENCHY_VISION_PROVIDER=gemini
BENCHY_VISION_MODEL=gemini-robotics-er-2-preview
GEMINI_API_KEY=

# Grok voice debugging. Optional.
XAI_API_KEY=
